#!/usr/bin/env bash
# weevils-service — start, stop and watch weevilsd on this machine: with systemd --user on Linux, with launchd on a
# Mac (an agent of your session), otherwise as a plain background process (containers, WSL without systemd, a Mac
# reached over SSH with no session open). Installed in ~/.local/bin by install.sh. Runs under macOS's bash 3.2.
#
#   weevils-service start | stop | restart | status | logs
#   weevils-service add-remote <id> [url]     main machine: federate another weevilsd (prints its tunnel port);
#                                             WEEVILS_TOKEN_STDIN=1: that machine's local token, read on stdin
#   weevils-service remote-shell <id> <port>  the forced command of a key plugged in from one line (server/join.ts)
#   weevils-service tunnel                    secondary machine: asks the main machine for its port (and waits there
#                                             while it is switched off), then holds the reverse tunnel (the unit runs it)
#   weevils-service drop <id>                 main machine: cuts that machine's tunnel now (switched off in the app)
#   weevils-service config get <KEY> | set <KEY> <value> | default <KEY> <value>
#   weevils-service mode                      systemd, launchd or background
set -euo pipefail

# Always ~/.config/weevils (not XDG_CONFIG_HOME): the server and the systemd unit read it there.
CONFIG_DIR=$HOME/.config/weevils
CONFIG_FILE=${WEEVILS_CONFIG:-$CONFIG_DIR/env}
SERVICE_CONF=$CONFIG_DIR/service.conf
RUN_DIR=$HOME/.local/share/weevils/run
LOG_FILE=$HOME/.local/share/weevils/weevilsd.log
TUNNEL_LOG=$HOME/.local/share/weevils/tunnel.log

# ---------------------------------------------------------------- config file (NAME=value, first occurrence wins, like server/config.ts)

cfg_get() {
  [ -f "$CONFIG_FILE" ] || return 0
  sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$CONFIG_FILE" | head -1 | sed "s/[[:space:]]*$//; s/^[\"']//; s/[\"']$//"
}

# cfg_set KEY VALUE [set|default] — default only fills an empty or missing key. Replaces the first line of the key
# (or its commented example), appends otherwise. Never touches other lines.
cfg_set() {
  local k=$1 v=$2 mode=${3:-set}
  mkdir -p "$(dirname "$CONFIG_FILE")"
  [ -f "$CONFIG_FILE" ] || { : >"$CONFIG_FILE"; chmod 600 "$CONFIG_FILE"; }
  if [ "$mode" = default ] && [ -n "$(cfg_get "$k")" ]; then return 0; fi
  local re="^[[:space:]]*${k}[[:space:]]*="
  grep -qE "$re" "$CONFIG_FILE" || re="^[[:space:]]*#[[:space:]]*${k}[[:space:]]*="
  if grep -qE "$re" "$CONFIG_FILE"; then
    local tmp; tmp=$(mktemp)
    K=$k V=$v RE=$re awk 'BEGIN { done = 0 } !done && $0 ~ ENVIRON["RE"] { print ENVIRON["K"] "=" ENVIRON["V"]; done = 1; next } { print }' "$CONFIG_FILE" >"$tmp"
    cat "$tmp" >"$CONFIG_FILE" && rm -f "$tmp"
  else
    printf '%s=%s\n' "$k" "$v" >>"$CONFIG_FILE"
  fi
}

# ---------------------------------------------------------------- systemd --user, when it is there

systemd_user() {
  [ -d /run/systemd/system ] && command -v systemctl >/dev/null || return 1
  export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
  if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS=unix:path=$XDG_RUNTIME_DIR/bus
  fi
  systemctl --user show-environment >/dev/null 2>&1
}

load_service_conf() {
  WEEVILS_ROLE=main WEEVILS_DIR='' WEEVILS_NODE=$(command -v node || true) WEEVILS_PATH=$PATH WEEVILS_MAIN_HOST='' WEEVILS_TUNNEL_PORT=''
  # shellcheck disable=SC1090
  [ -f "$SERVICE_CONF" ] && . "$SERVICE_CONF"
  WEEVILS_PORT=$(cfg_get WEEVILS_PORT); WEEVILS_PORT=${WEEVILS_PORT:-4179}
}

units() { if [ "$WEEVILS_ROLE" = secondary ] && [ -n "$WEEVILS_MAIN_HOST" ]; then echo weevilsd weevils-tunnel; else echo weevilsd; fi; }

# ---------------------------------------------------------------- launchd, on a Mac
# The agents live in ~/Library/LaunchAgents (written by server/install.sh) and run in the session opened on the Mac's
# screen (gui/<uid>): that is where the Keychain, and so Claude Code's login, can be reached.

LAUNCH_DIR=$HOME/Library/LaunchAgents
LAUNCH_PREFIX=com.github.sc4rville
label() { echo "$LAUNCH_PREFIX.$1"; }

launchd_domain() {
  [ "$(uname -s)" = Darwin ] && command -v launchctl >/dev/null || return 1
  local dom; dom=gui/$(id -u)
  launchctl print "$dom" >/dev/null 2>&1 || return 1
  echo "$dom"
}
launchd_loaded() { launchctl print "$1/$(label "$2")" >/dev/null 2>&1; }
# launchd_gone <domain> <unit> — waits (up to 15 s) until the job has left launchd: bootout returns before that.
launchd_gone() {
  local n=0
  while launchd_loaded "$1" "$2" && [ "$n" -lt 30 ]; do sleep 0.5; n=$((n + 1)); done
}
# The copy of each agent's file as launchd was last given it (launchd_load), to tell whether the file changed since.
LAUNCHD_SEEN=$RUN_DIR/launchd
launchd_seen() { echo "$LAUNCHD_SEEN/$(label "$1").plist"; }
# launchd_load <domain> <unit> — restarts the agent, and (re)loads it from its file only when launchd does not have
# it or the file changed since it was loaded (a new install). For macOS, each load of an agent is a background item
# added, announced in a notification ("Background Items Added") every time: a restart with the same file (every
# update, every restart asked for) restarts the job in place instead (kickstart -k), and macOS says nothing.
launchd_load() {
  local dom=$1 u=$2 plist n=0
  plist=$LAUNCH_DIR/$(label "$u").plist
  [ -f "$plist" ] || return 0
  if launchd_loaded "$dom" "$u" && cmp -s "$plist" "$(launchd_seen "$u")" &&
    launchctl kickstart -k "$dom/$(label "$u")" >/dev/null 2>&1; then return 0; fi
  launchctl enable "$dom/$(label "$u")" >/dev/null 2>&1 || true
  if launchd_loaded "$dom" "$u"; then
    launchctl bootout "$dom/$(label "$u")" >/dev/null 2>&1 || true
    launchd_gone "$dom" "$u"
  fi
  rm -f "$(launchd_seen "$u")"
  while [ "$n" -lt 6 ]; do
    if launchctl bootstrap "$dom" "$plist" >/dev/null 2>&1; then
      mkdir -p "$LAUNCHD_SEEN" && cp -f "$plist" "$(launchd_seen "$u")" || true
      return 0
    fi
    # Still there after all (a slow stop): restart it in place.
    if launchd_loaded "$dom" "$u"; then launchctl kickstart -k "$dom/$(label "$u")" >/dev/null 2>&1 || true; return 0; fi
    sleep 1; n=$((n + 1))
  done
  echo "weevils-service: launchd refused $plist (launchctl bootstrap $dom)" >&2
  return 1
}
launchd_unload() {
  rm -f "$(launchd_seen "$2")"
  launchd_loaded "$1" "$2" || return 0
  launchctl bootout "$1/$(label "$2")" >/dev/null 2>&1 || true
  launchd_gone "$1" "$2"
}
launchd_status() {
  local out pid
  if out=$(launchctl print "$1/$(label "$2")" 2>/dev/null); then
    pid=$(printf '%s\n' "$out" | sed -n 's/^[[:space:]]*pid = \([0-9][0-9]*\).*/\1/p' | head -1)
    if [ -n "$pid" ]; then echo "$2: running (pid $pid, launchd)"; else echo "$2: loaded, not running (launchd)"; fi
  else echo "$2: stopped"; fi
}

# ---------------------------------------------------------------- background mode (no systemd, no launchd)

# detach cmd… & — cmd in its own session, so it outlives the terminal and can be killed with its whole group. Only
# ever run in the background: it replaces its own (sub)shell, so $! is the command's pid, as the pid files need.
detach() {
  if command -v setsid >/dev/null; then exec setsid "$@"
  elif command -v perl >/dev/null; then exec perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV or exit 127' "$@"
  else exec "$@"; fi
}

pid_alive() { local f=$RUN_DIR/$1.pid; [ -f "$f" ] && kill -0 "$(cat "$f")" 2>/dev/null; }

bg_start() {
  mkdir -p "$RUN_DIR"
  if ! pid_alive weevilsd; then
    [ -n "$WEEVILS_DIR" ] || { echo "weevils-service: $SERVICE_CONF is missing, run install.sh again" >&2; exit 1; }
    # A simple command in the background (no "cd &&" list): $! is node itself, and nothing keeps our stdout open.
    (cd "$WEEVILS_DIR" || exit 1
      PATH=$WEEVILS_PATH NODE_ENV=production detach nohup "$WEEVILS_NODE" server/index.ts >>"$LOG_FILE" 2>&1 </dev/null &
      echo $! >"$RUN_DIR/weevilsd.pid")
  fi
  if [ "$(units)" != weevilsd ] && ! pid_alive weevils-tunnel; then
    (detach nohup bash -c 'while :; do "$1" tunnel; sleep 3; done' _ "$0" >>"$TUNNEL_LOG" 2>&1 </dev/null &
      echo $! >"$RUN_DIR/weevils-tunnel.pid")
  fi
}

bg_stop() {
  local u
  for u in weevils-tunnel weevilsd; do
    # Only the daemon dies: the tmux server holding the agent sessions is its own process and keeps running.
    # The tunnel loop is killed with its whole process group (the loop and its ssh).
    if pid_alive "$u"; then
      if [ "$u" = weevils-tunnel ]; then kill -- "-$(cat "$RUN_DIR/$u.pid")" 2>/dev/null || true
      else kill "$(cat "$RUN_DIR/$u.pid")" 2>/dev/null || true; fi
    fi
    rm -f "$RUN_DIR/$u.pid"
  done
}

bg_status() {
  local u
  for u in $(units); do
    if pid_alive "$u"; then echo "$u: running (pid $(cat "$RUN_DIR/$u.pid"), background)"; else echo "$u: stopped"; fi
  done
}

# ---------------------------------------------------------------- main machine: register a secondary one

# listening <port> — something already listens on it here, on any address (a program on 0.0.0.0:<port> keeps the
# tunnel's sshd from binding 127.0.0.1:<port> too). Linux: /proc/net/tcp and tcp6 (no ss needed); a Mac: lsof.
listening() {
  if [ -r /proc/net/tcp ]; then
    cat /proc/net/tcp /proc/net/tcp6 2>/dev/null | awk -v p="$(printf ':%04X' "$1")" '$4 == "0A" && substr($2, length($2) - 4) == p { f = 1 } END { exit !f }'
  elif command -v lsof >/dev/null; then lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
  else return 1; fi
}

# taken_ports — the tunnel ports already given: other machines' (WEEVILS_REMOTES), the keys' (authorized_keys), and the
# one-time codes still open (join.json).
taken_ports() {
  {
    cfg_get WEEVILS_REMOTES | grep -oE ':[0-9]+' | tr -d : || true
    grep -oE 'permitlisten="127\.0\.0\.1:[0-9]+"' "$HOME/.ssh/authorized_keys" 2>/dev/null | grep -oE '[0-9]+"$' | tr -d '"' || true
    grep -oE '"port":[0-9]+' "$HOME/.local/share/weevils/join.json" 2>/dev/null | grep -oE '[0-9]+$' || true
  } | sort -u
}

# move_remote <id> <port> — that machine's port is held by another program here: it gets the first free one, in its
# key (both ways and in its forced command) and in WEEVILS_REMOTES. Prints the new port.
move_remote() {
  local id=$1 old=$2 new=4192 taken ak=$HOME/.ssh/authorized_keys tmp
  grep -q "weevils-join:$id\$" "$ak" 2>/dev/null || return 1
  taken=$(taken_ports)
  while [ "$new" = "$old" ] || grep -qx "$new" <<<"$taken" || listening "$new"; do new=$((new + 1)); done
  tmp=$ak.weevils.tmp
  ID=$id O=$old N=$new awk '{
    if ($0 ~ ("weevils-join:" ENVIRON["ID"] "$")) {
      gsub("127\\.0\\.0\\.1:" ENVIRON["O"] "\"", "127.0.0.1:" ENVIRON["N"] "\"")
      gsub("remote-shell " ENVIRON["ID"] " " ENVIRON["O"] "\"", "remote-shell " ENVIRON["ID"] " " ENVIRON["N"] "\"")
    }
    print
  }' "$ak" >"$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$ak"
  echo "weevils-service: $id moved from port $old (held by another program) to $new" >&2
  add_remote "$id" "http://127.0.0.1:$new" >/dev/null
  echo "$new"
}

# hold_remote <id> <port> — before each tunnel of that machine: while it is switched off in the app (remotes/<id>.off)
# this waits (an answer within half a second of « on », up to 10 minutes, then « off » and the machine asks again);
# then a dead connection of its own on its port goes (reclaim_port), and a port another program holds is changed
# (move_remote). Answers « port <n> »: the port to listen on.
hold_remote() {
  local id=$1 port=$2 off=$CONFIG_DIR/remotes/$1.off i=0
  while [ -e "$off" ]; do
    [ "$i" -lt 1200 ] || { echo off; return 0; }
    sleep 0.5; i=$((i + 1))
  done
  kill_session "$id"
  reclaim_port "$port"
  if listening "$port"; then
    sleep 1
    if listening "$port"; then port=$(move_remote "$id" "$port") || port=$2; fi
  fi
  echo "port $port"
}

# remote_token <id> — the secondary machine's local token, one line on stdin (« X-Weevils-Local: <hex> »), kept in
# ~/.config/weevils/remotes/<id>.token (0600): weevilsd sends it with every call to that machine (server/remotes.ts).
remote_token() {
  local id=$1 line dir=$CONFIG_DIR/remotes f
  IFS= read -r line || [ -n "$line" ] || return 0
  printf '%s' "$line" | grep -qiE '^x-weevils-local:[[:space:]]*[0-9a-f]{32,128}[[:space:]]*$' || { echo "weevils-service: not a weevils local token" >&2; return 1; }
  mkdir -p "$dir" && chmod 700 "$dir"
  f=$dir/$(printf '%s' "$id" | tr -c 'A-Za-z0-9_.-' '_').token
  [ "$(cat "$f" 2>/dev/null || true)" = "$line" ] && return 0
  (umask 077 && printf '%s\n' "$line" >"$f.tmp" && mv -f "$f.tmp" "$f")
}

add_remote() {
  local id=${1:?id} url=${2:-} remotes port used
  [ "${WEEVILS_TOKEN_STDIN:-0}" != 1 ] || remote_token "$id" || return 1
  remotes=$(cfg_get WEEVILS_REMOTES)
  local existing; existing=$(tr ',' '\n' <<<"$remotes" | sed -n "s/^[[:space:]]*$id=//p" | head -1)
  if [ -z "$url" ]; then
    if [ -n "$existing" ]; then url=$existing
    else
      # First free port from 4192 that no other remote uses.
      used=$(grep -oE ':[0-9]+' <<<"$remotes" | tr -d : || true)
      port=4192
      while grep -qx "$port" <<<"$used" || listening "$port"; do port=$((port + 1)); done
      url=http://127.0.0.1:$port
    fi
  fi
  if [ "$existing" != "$url" ]; then
    local rest; rest=$(tr ',' '\n' <<<"$remotes" | grep -v "^[[:space:]]*$id=" | grep -v '^[[:space:]]*$' | paste -sd, - || true)
    cfg_set WEEVILS_REMOTES "${rest:+$rest,}$id=$url"
    "$0" restart >/dev/null 2>&1 || true
  fi
  echo "${url##*:}"
}

# remote_shell <id> <port> — the forced command of a key server/join.ts authorized (a computer plugged in from one line,
# docs/install.md). The ssh command it asked for (SSH_ORIGINAL_COMMAND) may only check the connection or register that
# same machine on that same tunnel port, as install.sh --secondary and weevils-update do. Never a shell, never anything else.
# reclaim_port <port> — stops the sshd process of this user that listens on 127.0.0.1:<port> (a reverse tunnel's
# end on this machine). Nothing else: another program on that port, or another user's, is left alone. Linux: the
# socket's inode in /proc/net/tcp, then the process holding it; elsewhere (a Mac): lsof.
reclaim_port() {
  local port=$1 pids='' inode fd pid comm
  if [ -r /proc/net/tcp ]; then
    for inode in $(awk -v a="$(printf '0100007F:%04X' "$port")" '$2 == a && $4 == "0A" { print $10 }' /proc/net/tcp); do
      for fd in /proc/[0-9]*/fd/*; do
        [ "$(readlink "$fd" 2>/dev/null)" = "socket:[$inode]" ] || continue
        pid=${fd#/proc/}; pids="$pids ${pid%%/*}"
      done
    done
  elif command -v lsof >/dev/null; then
    pids=$(lsof -nP -t -iTCP@127.0.0.1:"$port" -sTCP:LISTEN 2>/dev/null || true)
  fi
  for pid in $(printf '%s\n' $pids | sort -u); do
    comm=$(ps -o comm= -p "$pid" 2>/dev/null || true)
    case "${comm##*/}" in sshd | sshd-session | sshd:*) ;; *) continue ;; esac
    [ "$(ps -o uid= -p "$pid" 2>/dev/null | tr -d ' ')" = "$(id -u)" ] || continue
    kill "$pid" 2>/dev/null || true
  done
}

remote_shell() {
  local id=${1:?id} port=${2:?port} cmd=${SSH_ORIGINAL_COMMAND:-}
  [[ "$id" =~ ^[a-z0-9][a-z0-9-]{0,19}$ && "$port" =~ ^[0-9]{2,5}$ ]] || exit 1
  case "$cmd" in
    true | '') exit 0 ;;
    # The tunnel about to connect: a connection of this machine that still holds its port is dead (the tunnel only
    # starts again when the last one ended); sshd there would notice only hours later. It goes: that port only.
    'weevils-service reclaim') reclaim_port "$port"; exit 0 ;;
    # The tunnel about to connect (weevils-service tunnel there): may it, and on which port.
    'weevils-service hold') hold_remote "$id" "$port"; exit 0 ;;
    # The tunnel itself (after hold): stays while the machine is on here.
    'weevils-service tunnel-session') tunnel_session "$id"; exit 0 ;;
  esac
  local re='^WEEVILS_TOKEN_STDIN=1 [^ ]*weevils-service add-remote '"$id"'( http://127\.0\.0\.1:'"$port"')?$'
  if [[ "$cmd" =~ $re ]]; then
    load_service_conf
    WEEVILS_TOKEN_STDIN=1 add_remote "$id" "http://127.0.0.1:$port"
    return
  fi
  echo "weevils-service: this key only registers $id" >&2
  exit 1
}

# tunnel_session <id> — the command a secondary machine's tunnel runs here (its connection's « session »): it notes
# which sshd serves that connection (remotes/<id>.session: hold and drop end it, a dead one included, without reading
# sshd's sockets, which another process of the same user may not), then stays until the machine is switched off in the
# app (remotes/<id>.off): it ends, the connection with it, within half a second.
tunnel_session() {
  local id=$1 p=$PPID comm i=0 dir=$CONFIG_DIR/remotes
  while [ "$i" -lt 4 ] && [ -n "$p" ] && [ "$p" -gt 1 ]; do
    comm=$(ps -o comm= -p "$p" 2>/dev/null || true)
    case "${comm##*/}" in sshd | sshd-session | sshd:*) break ;; esac
    p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ' || true); i=$((i + 1))
  done
  mkdir -p "$dir" && chmod 700 "$dir"
  echo "$p" >"$dir/$id.session"
  while [ ! -e "$dir/$id.off" ]; do sleep 0.5; done
}

# kill_session <id> — ends the connection tunnel_session noted for that machine (its sshd, this user's only).
kill_session() {
  local f=$CONFIG_DIR/remotes/$1.session pid comm
  pid=$(cat "$f" 2>/dev/null || true)
  rm -f "$f"
  [[ "$pid" =~ ^[0-9]+$ ]] && [ "$pid" -gt 1 ] || return 0
  comm=$(ps -o comm= -p "$pid" 2>/dev/null || true)
  case "${comm##*/}" in sshd | sshd-session | sshd:*) ;; *) return 0 ;; esac
  [ "$(ps -o uid= -p "$pid" 2>/dev/null | tr -d ' ')" = "$(id -u)" ] || return 0
  kill "$pid" 2>/dev/null || true
}

# drop <id> — main machine: that machine was switched off in the app (weevilsd wrote remotes/<id>.off): its tunnel's
# end here goes now, and its next one waits in hold_remote until it is switched on again.
drop_remote() {
  local id=${1:?id} url port
  url=$(cfg_get WEEVILS_REMOTES | tr ',' '\n' | sed -n "s/^[[:space:]]*$id=//p" | head -1)
  port=${url##*:}
  kill_session "$id"
  [[ "$port" =~ ^[0-9]+$ ]] && reclaim_port "$port"
  return 0
}

# ---------------------------------------------------------------- secondary machine: the tunnel

# set_service_conf KEY VALUE — one line of service.conf (written by server/install.sh), replaced in place.
set_service_conf() {
  local tmp=$SERVICE_CONF.tmp
  K=$1 V=$2 awk 'BEGIN { d = 0 } $0 ~ ("^" ENVIRON["K"] "=") { print ENVIRON["K"] "=" ENVIRON["V"]; d = 1; next } { print } END { if (!d) print ENVIRON["K"] "=" ENVIRON["V"] }' "$SERVICE_CONF" >"$tmp" && mv -f "$tmp" "$SERVICE_CONF"
}

# tunnel — what the weevils-tunnel unit (or launchd agent) runs. The main machine first says whether this machine may
# connect and on which port (weevils-service hold there: it waits while this machine is switched off in the app, frees
# a port a dead connection still holds, moves one another program took); then the reverse tunnel itself. An older main
# machine knows no « hold »: reclaim as before, same port.
tunnel() {
  load_service_conf
  local host=$WEEVILS_MAIN_HOST port=$WEEVILS_TUNNEL_PORT here out new mode=(-N) session=()
  [ -n "$host" ] || { echo "weevils-service tunnel: not a secondary machine" >&2; sleep 30; exit 1; }
  here=$(cfg_get WEEVILS_PORT); here=${here:-4179}
  if out=$(ssh -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=20 -o ServerAliveCountMax=3 "$host" weevils-service hold </dev/null 2>/dev/null); then
    [ "$out" != off ] || exit 0
    # A main machine that knows « hold » runs the tunnel's session too: it ends it when this machine is switched off.
    mode=() session=(weevils-service tunnel-session)
    new=$(printf '%s\n' "$out" | sed -n 's/^port \([0-9][0-9]*\)$/\1/p' | tail -1)
    if [ -n "$new" ] && [ "$new" != "$port" ]; then
      echo "weevils-service tunnel: the main machine moved this machine to port $new (was $port)" >&2
      set_service_conf WEEVILS_TUNNEL_PORT "$new"
      port=$new
    fi
  else
    ssh -o BatchMode=yes -o ConnectTimeout=10 "$host" weevils-service reclaim </dev/null >/dev/null 2>&1 || true
  fi
  [[ "$port" =~ ^[0-9]+$ ]] || { echo "weevils-service tunnel: no tunnel port in $SERVICE_CONF" >&2; sleep 30; exit 1; }
  exec ssh -T ${mode[@]+"${mode[@]}"} -o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=20 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes \
    -R "127.0.0.1:$port:127.0.0.1:$here" "$host" ${session[@]+"${session[@]}"} </dev/null
}

# ----------------------------------------------------------------

cmd=${1:-status}
case "$cmd" in
  config)
    case "${2:-}" in
      get) cfg_get "${3:?key}" ;;
      set) cfg_set "${3:?key}" "${4-}" set ;;
      default) cfg_set "${3:?key}" "${4-}" default ;;
      *) echo "usage: weevils-service config get|set|default KEY [value]" >&2; exit 1 ;;
    esac ;;
  add-remote) shift; load_service_conf; add_remote "$@" ;;
  remote-shell) shift; remote_shell "$@" ;;
  drop) shift; drop_remote "$@" ;;
  tunnel) tunnel ;;
  mode) if systemd_user; then echo systemd; elif launchd_domain >/dev/null; then echo launchd; else echo background; fi ;;
  start | stop | restart | status | logs)
    load_service_conf
    if systemd_user && [ -f "$HOME/.config/systemd/user/weevilsd.service" ]; then
      case "$cmd" in
        start) bg_stop; systemctl --user enable --now $(units) >/dev/null 2>&1; systemctl --user start $(units) ;;
        stop) systemctl --user stop $(units) ;;
        restart) bg_stop; systemctl --user enable $(units) >/dev/null 2>&1; systemctl --user restart $(units) ;;
        status) for u in $(units); do echo "$u: $(systemctl --user is-active "$u" 2>/dev/null || true) (systemd --user)"; done ;;
        logs) exec journalctl --user -u weevilsd -n 100 -f ;;
      esac
    elif dom=$(launchd_domain) && [ -f "$LAUNCH_DIR/$(label weevilsd).plist" ]; then
      case "$cmd" in
        start) bg_stop
          for u in $(units); do
            if launchd_loaded "$dom" "$u"; then launchctl kickstart "$dom/$(label "$u")" >/dev/null 2>&1 || true
            else launchd_load "$dom" "$u"; fi
          done ;;
        stop) for u in weevils-tunnel weevilsd; do launchd_unload "$dom" "$u"; done ;;
        restart) bg_stop; for u in $(units); do launchd_load "$dom" "$u"; done ;;
        status) for u in $(units); do launchd_status "$dom" "$u"; done ;;
        logs) exec tail -n 100 -f "$LOG_FILE" ;;
      esac
    else
      case "$cmd" in
        start) bg_start ;;
        stop) bg_stop ;;
        restart) bg_stop; sleep 1; bg_start ;;
        status) bg_status ;;
        logs) exec tail -n 100 -f "$LOG_FILE" ;;
      esac
    fi ;;
  *) sed -n 2,10p "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
