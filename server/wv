#!/usr/bin/env bash
# wv — lance claude ou codex dans une session tmux que weevils voit et pilote depuis l'iPhone.
#
#   wv                  claude dans le dossier courant
#   wv "fais ceci"      claude avec un premier message
#   wv codex [msg]      codex
#   wv ls               sessions wv en cours
#   wv a [nom]          s'y rattacher (la plus récente par défaut)
#   wv vps <repo> [...]  depuis le PC : la même chose, mais sur le VPS (~/projects/<repo>)
#   wv vps a | wv vps ls se rattacher / lister sur le VPS
#
# Sans demande de permission (comme d'habitude) ; WV_SAFE=1 wv … pour garder les confirmations.
set -euo pipefail

if [ "${WV_SAFE:-}" = 1 ]; then claude_flags=(); codex_flags=()
else claude_flags=(--dangerously-skip-permissions); codex_flags=(--dangerously-bypass-approvals-and-sandbox); fi

if [ "${1:-}" = vps ]; then
  shift
  case "${1:-}" in
    ''|a|attach|ls) exec ssh -t vps "wv ${1:-a} ${2:-}" ;;
  esac
  repo=$1; shift
  exec ssh -t vps "cd ~/projects/$(printf '%q' "$repo") && wv $(printf '%q ' "$@")"
fi

tool=claude
case "${1:-}" in
  ls)
    tmux list-sessions -F '#{session_name}  #{@wv_tool}  #{@wv_cwd}' 2>/dev/null | grep '^wv-' || echo "aucune session wv"
    exit 0 ;;
  a|attach)
    name=${2:-$(tmux list-sessions -F '#{session_created} #{session_name}' 2>/dev/null | grep ' wv-' | sort -n | tail -1 | cut -d' ' -f2)}
    [ -n "$name" ] || { echo "aucune session wv"; exit 1; }
    if [ -n "${TMUX:-}" ]; then exec tmux switch-client -t "=$name"; else exec tmux attach -t "=$name"; fi ;;
  claude|codex)
    tool=$1; shift ;;
esac

dir=$(basename "$PWD")
short=$(od -An -N3 -tx1 /dev/urandom | tr -d ' \n')
name="wv-${dir:0:18}-$short"
title=${1:-nouvelle session}

if [ "$tool" = claude ]; then
  id=$(cat /proc/sys/kernel/random/uuid)
  tmux new-session -d -s "$name" -x 120 -y 40 -c "$PWD" claude "${claude_flags[@]}" --session-id "$id" "$@"
  tmux set-option -t "=$name:" @wv_session_id "$id"
else
  tmux new-session -d -s "$name" -x 120 -y 40 -c "$PWD" codex "${codex_flags[@]}" "$@"
fi
tmux set-option -t "=$name:" @wv_tool "$tool"
tmux set-option -t "=$name:" @wv_title "${title:0:60}"
tmux set-option -t "=$name:" @wv_cwd "$PWD"

if [ -n "${TMUX:-}" ]; then exec tmux switch-client -t "=$name"; else exec tmux attach -t "=$name"; fi
