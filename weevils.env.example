# Configuration de weevils : copie ce fichier en ~/.config/weevils/env (hors du repo), puis
#   systemctl --user restart weevilsd
# Une valeur par ligne, NOM=valeur. Tout est optionnel.

# Ton prénom : les agents (weevboss, titres, voix) s'adressent à toi par ce nom. Vide : « l'utilisateur ».
WEEVILS_USER_NAME=

# Adresse publique de l'app (notifications push, lien de connexion).
WEEVILS_PUBLIC_URL=https://weevils.example.com

# Domaine où tes serveurs de preview sont exposés en <nom>.<domaine> (navigateur intégré).
WEEVILS_EXPOSE_DOMAIN=example.com

# Compte GitHub des repos (page repos, weevboss). Vide : celui de `gh`.
WEEVILS_GH_OWNER=

# Cette machine (plusieurs machines : un weevilsd par machine, fédérés).
WEEVILS_MACHINE=vps
WEEVILS_MACHINE_NAME=vps
# Autres weevilsd à fédérer : nom=url
#WEEVILS_REMOTES=pc=http://127.0.0.1:4192

# Dictée et résumé oral (OpenAI), voix (Cartesia, sinon edge-tts).
OPENAI_API_KEY=
CARTESIA_API_KEY=
#CARTESIA_VOICE_ID=
#CARTESIA_MODEL=sonic-2
