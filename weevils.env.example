# weevils configuration — lives outside the repo, in ~/.config/weevils/env.
# install.sh creates it from this file and never overwrites a value you set.
# After a change: weevils-service restart
# One value per line, NAME=value. Everything is optional.

# Your first name: the agents (weevboss, titles, voice) call you by it. Empty: "the user".
WEEVILS_USER_NAME=

# Language of what the server writes (agent prompts, notifications, errors): en or fr.
# Empty: system locale. The app follows the browser, and its language setting updates this one.
WEEVILS_LANG=

# Public address of the app (push notifications, login link), e.g. https://weevils.example.com
WEEVILS_PUBLIC_URL=

# Port of the app and API (127.0.0.1 only unless WEEVILS_HOST says otherwise), and of the local hook receiver.
WEEVILS_PORT=4179
WEEVILS_HOOK_PORT=4180
# Listen address: 127.0.0.1 behind Caddy or an SSH tunnel; 0.0.0.0 to open it to your LAN over plain http.
#WEEVILS_HOST=127.0.0.1

# Folders where your projects live (absolute paths, separated by ":"). Default: ~/projects.
#WEEVILS_PROJECTS=/home/you/projects:/home/you/code

# Domain where your preview servers are exposed as <name>.<domain> (built-in browser), e.g. example.com
WEEVILS_EXPOSE_DOMAIN=

# GitHub account of your repos (repos page, weevboss). Empty: the one `gh` is logged in with.
WEEVILS_GH_OWNER=

# This machine: id (short, lowercase) and display name. Several machines = one weevilsd each, federated.
WEEVILS_MACHINE=
WEEVILS_MACHINE_NAME=
# 1 on the main machine (it runs weevboss and serves the app), 0 on a secondary machine.
WEEVILS_ORCHESTRATOR=1
# Other weevilsd to federate, name=url separated by commas (install.sh --secondary fills it in on the main machine).
#WEEVILS_REMOTES=laptop=http://127.0.0.1:4192

# Dictation and spoken summaries (OpenAI), voice (Cartesia, otherwise edge-tts).
OPENAI_API_KEY=
CARTESIA_API_KEY=
#CARTESIA_VOICE_ID=
#CARTESIA_MODEL=sonic-latest

# Devil mode: another model (open-weight, self-hosted) behind an OpenAI-compatible API. Empty: not connected.
DEVIL_API_URL=
DEVIL_API_KEY=
DEVIL_MODEL=

# Auteurs : qui peut signer un message dans une session, à part toi (weevboss est toujours là, en violet).
# Une ligne par auteur : WEEVILS_AUTHOR_<ID>=nom affiché | couleur | e-mails autorisés (virgules) | secret partagé (optionnel)
# Ses messages s'affichent signés de son nom, dans sa couleur ; dans le transcript ils commencent par [from:<id>].
#WEEVILS_AUTHOR_GEPETTO=gepetto | #3fc1f0 | gepetto@example.com
#WEEVILS_AUTHOR_INSTINCT=instinct | #ff6b8a | instinct@example.com | un-secret-long

# Pont e-mail : les auteurs ci-dessus écrivent aux sessions par e-mail (voir README, « Pont e-mail »).
# L'adresse du pont reçoit et répond : un alias de ta boîte Gmail (toi+weevils@gmail.com). Un filtre Gmail
# « à : toi+weevils@gmail.com » → libellé weevils + ne pas afficher dans la boîte de réception. Le pont ne surveille
# que ce libellé (jamais INBOX) et ne touche à aucun autre mail. Mot de passe d'application Google (validation en deux étapes requise).
WEEVILS_MAIL_ADDRESS=
WEEVILS_MAIL_PASSWORD=
# Libellé surveillé (défaut weevils) ; compte de connexion (défaut : l'adresse sans le +alias).
#WEEVILS_MAIL_LABEL=weevils
#WEEVILS_MAIL_LOGIN=toi@gmail.com
# Hors Gmail : serveurs (TLS direct) et serveur de réception dont on croit l'en-tête Authentication-Results.
#WEEVILS_MAIL_IMAP=imap.example.com:993
#WEEVILS_MAIL_SMTP=smtp.example.com:465
#WEEVILS_MAIL_AUTHSERV=mx.example.com
# Limite par auteur, et attente max de la réponse d'une session avant de répondre « toujours en cours ».
#WEEVILS_MAIL_PER_MINUTE=5
#WEEVILS_MAIL_PER_HOUR=30
#WEEVILS_MAIL_REPLY_MIN=45
